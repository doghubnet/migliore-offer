{
  "colors": {
    "brand-900": "#0b1020",
    "brand-700": "#12213a",
    "brand-500": "#2a66ff",
    "accent-500": "#7c5cff",
    "muted-300": "#f4f6fb",
    "bg": "#ffffff",
    "card": "rgba(11,16,32,0.04)",
    "glass": "rgba(255,255,255,0.06)",
    "success": "#14c38e",
    "danger": "#ff5263",
    "text-primary": "#0b1020",
    "text-muted": "#6b7280"
  },
  "typography": {
    "font-family": "Inter, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial",
    "base": "16px",
    "scale": [16, 18, 20, 24, 28, 36, 48, 64],
    "lineHeights": {
      "body": 1.6,
      "heading": 1.2
